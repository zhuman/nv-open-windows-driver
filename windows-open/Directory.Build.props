<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WindowsOpenRoot>$(MSBuildThisFileDirectory)</WindowsOpenRoot>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(WindowsOpenRoot)..\'))</RepoRoot>
    <NvidiaSdkInclude>$(RepoRoot)src\common\sdk\nvidia\inc</NvidiaSdkInclude>
    <NvidiaCommonInclude>$(RepoRoot)src\common\inc</NvidiaCommonInclude>
    <NvWindowsCommonInclude>$(WindowsOpenRoot)common\include</NvWindowsCommonInclude>
    <NvidiaVersionFile>$(RepoRoot)version.mk</NvidiaVersionFile>
    <NvidiaVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(NvidiaVersionFile)')), '(?m)^NVIDIA_VERSION\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</NvidiaVersion>
    <NvArchitectureDefinitions Condition="'$(Platform)' == 'x64'">_AMD64_=1</NvArchitectureDefinitions>
    <NvArchitectureDefinitions Condition="'$(Platform)' == 'ARM64'">_ARM64_=1</NvArchitectureDefinitions>
    <NvDownstreamBugfixes Condition="'$(NvDownstreamBugfixes)' == ''">true</NvDownstreamBugfixes>
    <NvRmVerboseDiagnostics Condition="'$(NvRmVerboseDiagnostics)' == ''">false</NvRmVerboseDiagnostics>
    <OutDir>$(WindowsOpenRoot)out\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(WindowsOpenRoot)out\obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <TargetName>$(MSBuildProjectName)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(NvidiaSdkInclude);$(NvidiaCommonInclude);$(NvWindowsCommonInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(NvDownstreamBugfixes)' == 'true'">NV_DOWNSTREAM_BUGFIXES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(NvRmVerboseDiagnostics)' == 'true'">NV_RM_VERBOSE_DIAGNOSTICS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>