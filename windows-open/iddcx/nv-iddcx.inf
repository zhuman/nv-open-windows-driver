[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
ClassVer=2.0
Provider=%ProviderName%
CatalogFile=nv-iddcx.cat
DriverVer=07/15/2026,0.1.0.0
PnpLockDown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceName%=NvIddCx_Install,Root\NvWindowsIddCx

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
nv-iddcx.dll=1

[DestinationDirs]
UmdfCopy=12,UMDF

[UmdfCopy]
nv-iddcx.dll

[NvIddCx_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UmdfCopy

[NvIddCx_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=NvIddCx_HardwareSettings

[NvIddCx_HardwareSettings]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"NvWindowsIddCxGroup"

[NvIddCx_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[NvIddCx_Install.NT.Wdf]
UmdfService=nv-iddcx,NvIddCx_Service
UmdfServiceOrder=nv-iddcx

[NvIddCx_Service]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\nv-iddcx.dll
UmdfExtensions=IddCx0102

[Strings]
ProviderName="NVIDIA Open GPU Kernel Modules"
DeviceName="NVIDIA Experimental Indirect Display Adapter"
DiskName="NVIDIA Experimental Windows Driver Disk"